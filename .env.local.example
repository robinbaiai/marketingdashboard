# 本文件只是模板，不放真实密钥。
# 复制为 .env.local 后填写本机可用的大模型网关配置；.env.local 已被 .gitignore 忽略。

# 推荐：如果 richman 已经测通 TKS 中转，就沿用同一组配置。
CHAIN_LLM_API_KEY=替换为你的TKS网关apikey
CHAIN_LLM_BASE_URL=https://tks.eyuai.com/v1
CHAIN_LLM_MODELS=deepseek-v4-pro,kimi-for-coding,MiniMax-M3,deepseek-v4-flash
CHAIN_LLM_TIMEOUT_MS=45000

# 如果不用 CHAIN_LLM_*，也可以分别配置 provider。
# 端点同样可以全部指向 TKS 中转，但 key/baseUrl 必须和该网关匹配。
# KIMI_API_KEY=替换为TKS网关apikey
# KIMI_BASE_URL=https://tks.eyuai.com/v1
# KIMI_MODELS=kimi-for-coding
#
# DEEPSEEK_API_KEY=替换为TKS网关apikey
# DEEPSEEK_BASE_URL=https://tks.eyuai.com/v1
# DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
#
# MINIMAX_API_KEY=替换为TKS网关apikey
# MINIMAX_BASE_URL=https://tks.eyuai.com/v1
# MINIMAX_MODELS=MiniMax-M3
